<?xml version="1.0" encoding="utf-8"?>
<!-- L'app aperta da Kanso cresce dal centro, morbida, senza scatti. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:shareInterpolator="true">
    <scale
        android:duration="420"
        android:fromXScale="0.86"
        android:fromYScale="0.86"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
    <alpha
        android:duration="260"
        android:fromAlpha="0"
        android:toAlpha="1" />
</set>
